# Local-first default.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_NATIVE_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Optional cloud providers. Leave unset unless the user opts in.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Colon-separated on macOS/Linux, semicolon-separated on Windows.
# If unset, the backend scopes tools to the process working directory.
CHAT_SOFTWARE_ALLOWED_ROOTS=
CHAT_SOFTWARE_STATE_DIR=.chat_software_state
CHAT_SOFTWARE_HOST=127.0.0.1
CHAT_SOFTWARE_PORT=8765

# Tests and demos only. When enabled, chat returns a labeled echo instead of
# calling the configured model provider.
CHAT_SOFTWARE_OFFLINE_ECHO=0

# Documents mode: Hybrid Retrieval Lab knowledge API (retrieval stays in that service).
# Plain http is accepted only for loopback; use https for any other host.
CHAT_SOFTWARE_KNOWLEDGE_URL=
# Workspace-scoped, read-only hrk_ key issued by the Retrieval Lab. Stays in the sidecar;
# bindings refer to it by name (CHAT_SOFTWARE_KNOWLEDGE_*KEY), never by value.
CHAT_SOFTWARE_KNOWLEDGE_API_KEY=
# Optional: write-scoped hik_ ingest key for the same single workspace. Enables "Submit Files"
# (preview, then explicit approve). Leave unset to keep document mode read-only.
CHAT_SOFTWARE_KNOWLEDGE_INGEST_KEY=
# Optional relevance gate (fail closed): rerank score first, else dense similarity.
# CHAT_SOFTWARE_DOCS_MIN_RERANK=0.0
# CHAT_SOFTWARE_DOCS_MIN_DENSE=0.30
